{
  "name": "push-hygiene-common",
  "target": "push",
  "enforcement": "disabled",
  "conditions": {
    "ref_name": {
      "include": [
        "~ALL"
      ],
      "exclude": []
    }
  },
  "rules": [
    {
      "type": "file_path_restriction",
      "parameters": {
        "restricted_file_paths": [
          ".env",
          "**/.env",
          "**/.env.*",
          "**/node_modules/**",
          "**/dist/**",
          "**/build/**",
          "**/.next/**",
          "**/coverage/**"
        ]
      }
    },
    {
      "type": "file_extension_restriction",
      "parameters": {
        "restricted_file_extensions": [
          ".zip",
          ".7z",
          ".rar",
          ".exe",
          ".dll",
          ".pdb",
          ".mp4",
          ".mov"
        ]
      }
    },
    {
      "type": "max_file_size",
      "parameters": {
        "max_file_size": 25
      }
    }
  ]
}
